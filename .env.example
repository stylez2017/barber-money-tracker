# Used only for ordinary Next.js development; keep real local values untracked.
# In Cloudflare previews, set these as runtime variables/secrets instead.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_PUBLIC_KEY
CLERK_SECRET_KEY=
# Optional explicit list of allowed app origins, separated by commas.
# If omitted, the server requires the token azp to equal the request URL origin.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Stripe TEST mode only. Keep both secrets private and untracked.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public price identifier: $4.99 USD, recurring monthly, quantity one.
STRIPE_PRICE_ID=
APP_ORIGIN=http://localhost:3000

# Private testing: requires an isolated PRIVATE_TEST_DB D1 binding in workerd.
# Configure these on Previews Base only, never production.
# APP_ACCESS_MODE=private-test
# PRIVATE_TEST_USER_IDS=user_YOUR_APPROVED_CLERK_USER_ID
